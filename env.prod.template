# =============================================================================
# Production Environment — Zigzag Backend
# =============================================================================
# Copy this file to .env.prod on the droplet and fill in real values.
# NEVER commit .env.prod to the repository.
# =============================================================================

APP_ENV=prod
APP_SECRET=<generate: php -r "echo bin2hex(random_bytes(16));">
DEFAULT_URI=https://yourdomain.com
APP_SHARE_DIR=var/share
TRUSTED_PROXIES=REMOTE_ADDR,173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22
TRUSTED_HEADERS=HEADER_X_FORWARDED_FOR,HEADER_X_FORWARDED_HOST,HEADER_X_FORWARDED_PORT,HEADER_X_FORWARDED_PROTO

# ── Database (PostgreSQL + PostGIS) ──
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=<strong-password>
POSTGRES_VERSION=18
DATABASE_URL=postgresql://app:<password>@database:5432/app?serverVersion=18&charset=utf8

# ── Server ──
SERVER_NAME=yourdomain.com
HTTPS_PORT=443
HTTP_PORT=80
ACME_EMAIL=your@email.com
LAN_IP=<droplet-public-ip>

# ── Mercure ──
CADDY_MERCURE_JWT_SECRET=<generate: openssl rand -hex 32>
# MERCURE_URL is set per-slot in compose.prod.yaml (http://php-blue:80 or http://php-green:80)
MERCURE_JWT_SECRET=<same-as-CADDY_MERCURE_JWT_SECRET>

# ── RabbitMQ ──
RABBITMQ_DSN=phpamqplib://zigzag:<password>@rabbitmq:5672/%2f

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── JWT Auth ──
JWT_PASSPHRASE=<your-passphrase>

# ── Google Maps ──
GOOGLE_MAPS_API_KEY=<your-key>
GOOGLE_MAPS_FRONTEND_API_KEY=<your-key>

# ── Notifications ──
MAILER_DSN=smtp://user:pass@smtp.provider.com:587
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME="ZigZag School Transportation"
SMS_API_KEY=<your-key>
SMS_API_URL=<provider-url>
SMS_FROM_NUMBER=<number>
FCM_SERVER_KEY=<your-key>

# ── Mercado Pago ──
MERCADOPAGO_ACCESS_TOKEN=<prod-token>
MERCADOPAGO_PUBLIC_KEY=<prod-key>
MERCADOPAGO_WEBHOOK_SECRET=<secret>
MERCADOPAGO_MARKETPLACE_FEE_PERCENT=0
MERCADOPAGO_APP_ID=<app-id>
MERCADOPAGO_APP_SECRET=<app-secret>
MERCADOPAGO_OAUTH_REDIRECT_URI=https://yourdomain.com/oauth/mercadopago/callback
TOKEN_ENCRYPTION_KEY=<generate: php -r "echo base64_encode(random_bytes(32));">

# ── OpenSearch ──
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX_PREFIX=zigzag_prod_

# ── Grafana ──
GRAFANA_CLOUD_LOKI_HOST=logs-prod-XXX.grafana.net
GRAFANA_CLOUD_LOKI_USER=123456
GRAFANA_CLOUD_API_KEY=<your-key>
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=123456

# ── Feature Flags ──
DRIVER_ROUTE_MANAGEMENT_ENABLED=false
DISTRESS_PROXIMITY_KM=5.0

# ── CORS (production domain) ──
CORS_ALLOW_ORIGIN='^https://yourdomain\.com$'

# ── Lock ──
LOCK_DSN=redis://redis:6379
