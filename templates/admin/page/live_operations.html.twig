<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Operations — ZigZag Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <style>
        body { background: #f8f9fa; }
        #map-container { height: calc(100vh - 120px); min-height: 500px; }
        #route-list  { height: calc(100vh - 120px); overflow-y: auto; }
        #route-list turbo-frame { display: block; height: 100%; }
        #route-detail { height: calc(100vh - 120px); overflow-y: auto; }
        .route-card { cursor: pointer; transition: border-color .15s; }
        .route-card:hover { border-color: #0d6efd !important; }
        .route-card.selected { border-color: #0d6efd !important; background: #e9f0ff; }
        #alert-banner { position: fixed; top: 70px; left: 50%; transform: translateX(-50%);
            z-index: 9999; min-width: 360px; display: none; }
    </style>
</head>
<body>

<nav class="navbar navbar-dark bg-dark px-3 py-2">
    <a class="navbar-brand" href="{{ path('admin') }}">
        <i class="fas fa-arrow-left me-2"></i>ZigZag Admin
    </a>
    <span class="navbar-text fw-semibold">
        <i class="fas fa-map-location-dot me-1"></i> Live Operations Map
    </span>
    <span class="navbar-text">
        <span class="badge bg-success"><i class="fas fa-circle fa-xs me-1"></i>Live</span>
    </span>
</nav>

<div class="container-fluid p-3"
     data-controller="live-map"
     data-live-map-mercure-url-value="{{ mercurePublicUrl }}"
     data-live-map-drivers-url-value="{{ path('admin_api_active_drivers') }}">

    {# Alert banner #}
    <div id="alert-banner" class="alert alert-danger alert-dismissible shadow-sm"
         data-live-map-target="alertBanner">
        <i class="fas fa-triangle-exclamation me-2"></i>
        <strong>DISTRESS</strong> — <span data-live-map-target="alertText"></span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    <div class="row g-2">
        {# Left: route list (Turbo frame loads eagerly) #}
        <div class="col-md-3" id="route-list">
            <turbo-frame id="active-routes-list"
                         src="{{ path('admin_api_active_routes_list') }}"
                         loading="eager">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                    <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                    <p class="mb-0">Loading routes…</p>
                </div>
            </turbo-frame>
        </div>

        {# Center: map #}
        <div class="col-md-6">
            <div id="map-container" data-live-map-target="mapContainer"></div>
        </div>

        {# Right: route detail panel (hidden until a route is selected) #}
        <div class="col-md-3 d-none" id="route-detail" data-live-map-target="routeDetail">
            <turbo-frame id="route-detail-panel"></turbo-frame>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
{{ importmap('admin') }}

</body>
</html>
