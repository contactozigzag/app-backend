<turbo-frame id="route-detail-panel">
<div class="card border-0 shadow-sm">
    <div class="card-header bg-primary text-white py-2">
        <strong class="small">
            <i class="fas fa-route me-1"></i>
            {{ route.routeTemplate ? route.routeTemplate.name : 'Route #' ~ route.id }}
        </strong>
    </div>
    <div class="card-body py-2 px-3">

        {# Driver info #}
        <div class="mb-3">
            <div class="fw-semibold small text-muted text-uppercase mb-1">Driver</div>
            <div class="d-flex align-items-center gap-2">
                <i class="fas fa-id-card text-primary"></i>
                <div>
                    <div>{{ driverName }}</div>
                    {% if driverPhone %}
                        <div class="small text-muted"><i class="fas fa-phone me-1"></i>{{ driverPhone }}</div>
                    {% endif %}
                    {% if vehiclePlate %}
                        <div class="small text-muted"><i class="fas fa-truck me-1"></i>{{ vehiclePlate }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Progress #}
        <div class="mb-3">
            <div class="fw-semibold small text-muted text-uppercase mb-1">Progress</div>
            <div class="progress mb-1" style="height: 8px;">
                <div class="progress-bar bg-success" style="width: {{ progressPct }}%"></div>
            </div>
            <div class="small text-muted">{{ completedStops }} / {{ totalStops }} stops completed</div>
        </div>

        {# Student manifest #}
        <div class="fw-semibold small text-muted text-uppercase mb-1">Students</div>
        {% if stops is empty %}
            <p class="text-muted small">No stops</p>
        {% else %}
            <table class="table table-sm table-hover mb-2 small">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Student</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                {% for stop in stops %}
                    {% set statusColor = {
                        'pending': 'secondary',
                        'approaching': 'info',
                        'arrived': 'info',
                        'picked_up': 'success',
                        'dropped_off': 'primary',
                        'skipped': 'warning',
                        'absent': 'danger'
                    } %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>{{ stop.student ? stop.student.firstName ~ ' ' ~ stop.student.lastName : '—' }}</td>
                        <td>
                            <span class="badge bg-{{ statusColor[stop.status] ?? 'secondary' }}">
                                {{ stop.status|replace({'_': ' '})|title }}
                            </span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        <a href="{{ path('admin', {'crudControllerFqcn': 'App\\Controller\\Admin\\ActiveRouteCrudController', 'crudAction': 'detail', 'entityId': route.id}) }}"
           class="btn btn-sm btn-outline-primary w-100 mt-1">
            <i class="fas fa-external-link-alt me-1"></i>View Full Detail
        </a>
    </div>
</div>
</turbo-frame>
