<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Chat – Alert #{{ alert.id }} – ZigZag Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        .chat-bubble { max-width: 70%; }
        .chat-bubble .meta { font-size: .75rem; color: #6c757d; }
    </style>
</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark mb-4 px-3">
    <span class="navbar-brand fw-bold">
        <i class="fas fa-comments me-2"></i>Alert #{{ alert.id }} — Chat Messages
    </span>
    <a href="{{ path('admin', {'entityId': alert.id, 'crudController': 'App\\Controller\\Admin\\DriverAlertCrudController', 'crudAction': 'detail'}) }}"
       class="btn btn-sm btn-outline-light">
        <i class="fas fa-arrow-left me-1"></i> Back to Alert
    </a>
</nav>

<div class="container-fluid px-4">
    {% if messages is empty %}
        <div class="text-center text-muted py-5">
            <i class="fas fa-comments fa-3x mb-3 opacity-25"></i>
            <p>No chat messages for this alert.</p>
        </div>
    {% else %}
        <div class="d-flex flex-column gap-3">
            {% for msg in messages %}
            <div class="d-flex">
                <div class="chat-bubble bg-white border rounded-3 p-3 shadow-sm">
                    <div class="fw-semibold mb-1">
                        <i class="fas fa-user-circle me-1 text-secondary"></i>
                        {{ msg.sender }}
                    </div>
                    <div class="mb-2">{{ msg.content }}</div>
                    <div class="meta d-flex gap-3">
                        <span><i class="fas fa-clock me-1"></i>{{ msg.sentAt|date('Y-m-d H:i:s') }}</span>
                        <span><i class="fas fa-eye me-1"></i>Read by {{ msg.readByCount }}</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

</body>
</html>
