{% set raw_value = field.value %}
{% set json_string = raw_value is iterable
    ? raw_value|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE'))
    : (raw_value is not null ? raw_value : '') %}

{% if json_string is not empty %}
<div data-controller="json-preview">
    <button type="button"
            class="btn btn-sm btn-outline-secondary mb-1"
            data-action="click->json-preview#toggle"
            data-json-preview-target="toggle">
        <i class="fa fa-code"></i> Show JSON
    </button>
    <pre class="d-none bg-light border rounded p-2 mt-1"
         style="max-height: 300px; overflow-y: auto; font-size: 0.75rem;"
         data-json-preview-target="content"><code>{{ json_string }}</code></pre>
</div>
{% else %}
    <span class="text-muted">—</span>
{% endif %}
