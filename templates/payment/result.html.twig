{% extends 'base.html.twig' %}

{% block title %}{{ title }} - ZigZag{% endblock %}

{% block stylesheets %}
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0b1a2e;
        background-image: url('{{ asset('images/zigzag_bg.jpeg') }}');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    .result-card {
        width: 90%;
        max-width: 400px;
        background: rgba(11, 26, 46, 0.92);
        backdrop-filter: blur(12px);
        border-radius: 20px;
        padding: 2.5rem 2rem;
        text-align: center;
        color: #fff;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .result-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.5rem;
    }

    .result-icon--success { background: rgba(34, 197, 94, 0.15); }
    .result-icon--pending { background: rgba(250, 204, 21, 0.15); }
    .result-icon--failure { background: rgba(239, 68, 68, 0.15); }

    .result-icon svg {
        width: 40px;
        height: 40px;
    }

    .result-title {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .result-message {
        font-size: 0.95rem;
        color: rgba(255, 255, 255, 0.7);
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .result-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 1.5rem 0;
    }

    .result-footer {
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.4);
    }

    .result-footer strong {
        color: rgba(255, 255, 255, 0.6);
    }
</style>
{% endblock %}

{% block importmap %}{% endblock %}

{% block body %}
<div class="result-card">
    {% if status == 'success' %}
        <div class="result-icon result-icon--success">
            <svg viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6L9 17l-5-5"/>
            </svg>
        </div>
        <h1 class="result-title">Pago realizado</h1>
        <p class="result-message">
            Tu pago fue procesado con exito.
            Podes cerrar esta ventana y volver a la app.
        </p>

    {% elseif status == 'pending' %}
        <div class="result-icon result-icon--pending">
            <svg viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
        </div>
        <h1 class="result-title">Pago pendiente</h1>
        <p class="result-message">
            Tu pago esta siendo procesado.
            Te notificaremos cuando se confirme. Podes cerrar esta ventana.
        </p>

    {% else %}
        <div class="result-icon result-icon--failure">
            <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
        </div>
        <h1 class="result-title">Pago no realizado</h1>
        <p class="result-message">
            No pudimos procesar tu pago.
            Por favor, intenta nuevamente desde la app.
        </p>
    {% endif %}

    <div class="result-divider"></div>
    <p class="result-footer"><strong>ZigZag</strong> &middot; Transporte escolar seguro</p>
</div>
{% endblock %}
